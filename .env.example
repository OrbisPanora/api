# Minecraft World Configuration
WORLD_PATH=C:/Path/To/World
WORLD_DIMENSION=overworld

# API Configuration
API_HOST=localhost
API_PORT=8000
API_RELOAD=true

# CORS Configuration
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Cache Configuration
CACHE_ENABLED=true
CACHE_TYPE=memory
# CACHE_TYPE=redis  # For production
REDIS_URL=redis://localhost:6379
CACHE_TTL_HEIGHTMAP=300  # 5 minutes
CACHE_TTL_SURFACE=120    # 2 minutes
CACHE_TTL_CHUNK=600      # 10 minutes

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100  # requests per window
RATE_LIMIT_WINDOW=60     # window in seconds

# Compression
COMPRESSION_ENABLED=true
COMPRESSION_MIN_SIZE=500  # minimum bytes to compress
