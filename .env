# Defaults that suit every machine; committed. No secrets here.
# Per-machine values (a world path, a Redis password) go in .env.local, which is not
# committed and wins over this file. Every key is prefixed ORBISPANORA_; the full
# list, with defaults, is in orbispanora_api/settings.py or `orbispanora config show`.

ORBISPANORA_LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API from another site. Empty: none. The
# viewer is served from the same origin as the API, so it needs no entry. * allows every origin.
ORBISPANORA_CORS_ORIGINS=

ORBISPANORA_PORT=8081
